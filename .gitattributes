# Preserve existing bytes, including recovered inputs and historical hash evidence.
# Disabling newline conversion does not disable Git's normal text diffs.
* -text

# Original inputs, textures, audio and acceptance images use Git LFS.
*.apk filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
